# Ghost Admin API — from Ghost Admin > Settings > Integrations > Add custom integration
GHOST_ADMIN_API_URL="https://yourblog.ghost.io"
GHOST_ADMIN_API_KEY="<id>:<secret>"   # the "Admin API Key", form id:secret

# Optional: footer backlinks appended to every published post
REPO_URL="https://github.com/you/skills"
NEWSLETTER_URL="https://yourblog.ghost.io/#/portal/signup"
